{{!
    @template bookingextension_agent/benchmark_trend_chart

    Benchmark Trend Chart wrapper rendering.

    Example context (json):
    {
        "containerid": "benchmark-chart-container",
        "minwidth": 800,
        "charthtml": "<div>Rendered Moodle Chart</div>"
    }
}}
<div class="benchmark-chart-container" id="{{containerid}}" style="width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; margin-bottom: 20px;">
    <div style="min-width: {{minwidth}}px;">
        {{{charthtml}}}
    </div>
</div>

{{#js}}
require(['bookingextension_agent/benchmark_trend_chart'], function(ChartHelper) {
    ChartHelper.init("{{containerid}}");
});
{{/js}}
