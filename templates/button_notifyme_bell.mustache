{{!
    @template mod_booking/button_notifyme_bell

    The bare notify-me bell toggle. This partial renders ONLY the anchor with
    the bell icon and deliberately carries no wrapper, no price and no
    booking-button-area markup: it is embedded into the bookit button
    templates (bookit_price, bookit_button, mobile_bookit_button), and
    mustache partials inherit the full parent context. Anything more than the
    bell itself would leak parent data (like the price) into a second render.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-userid, data-itemid, data-area

    Example context (json):

    {
        "onlist": true,
        "userid": 1212,
        "itemid": 12,
        "area": "option"
    }
}}
<a class="booking-button-notify-me h3 text-center"
    data-userid="{{userid}}"
    data-itemid="{{itemid}}"
    data-area="{{area}}"
    data-toggle="tooltip"
    data-bs-toggle="tooltip"
    data-placement="top"
    title="{{#str}} notifyme, mod_booking {{/str}}">
    <i class="{{^onlist}}fa fa-bell-o{{/onlist}}{{#onlist}}fa fa-bell{{/onlist}}" aria-hidden="true"></i>
</a>
{{#js}}
    require(['mod_booking/button_notifyme'], function(init) {
        init.init();
    });
{{/js}}
