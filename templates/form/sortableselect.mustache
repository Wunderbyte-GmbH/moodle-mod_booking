{{!
    @template mod_booking/form/sortableselect

    Form element "sortable select": the chosen entries as an ordered list, and a select with a button to add
    an entry. The value is submitted by the hidden inputs of the entries (see sortableselect_item), in the
    order of the list. The first hidden input makes sure that an empty list is submitted too.
    mod_booking/form/sortableselect adds, moves and removes the entries.

    Context variables required for this template:
    * id - id of the element
    * name - name of the element
    * plainlabel - label of the element without HTML
    * emptyvalue - value that is submitted for an empty list
    * hasitems - whether entries are chosen
    * items - the chosen entries, see mod_booking/form/sortableselect_item
    * options - the entries that can be chosen: value, label, chosen
    * noselectionstring - text shown while nothing is chosen
    * choosestring - label and first entry of the select
    * addstring - text of the button to add an entry

    Example context (json):
    {
        "id": "id_searchprioritycolumns",
        "name": "searchprioritycolumns",
        "plainlabel": "Priority of the search results",
        "emptyvalue": "_qf__force_multiselect_submission",
        "hasitems": true,
        "items": [
            {"name": "searchprioritycolumns", "value": "titleprefix", "label": "Prefix", "position": 1, "first": true, "last": false},
            {"name": "searchprioritycolumns", "value": "text", "label": "Booking option name", "position": 2, "first": false, "last": true}
        ],
        "options": [
            {"value": "titleprefix", "label": "Prefix", "chosen": true},
            {"value": "text", "label": "Booking option name", "chosen": true},
            {"value": "location", "label": "Location", "chosen": false}
        ],
        "noselectionstring": "Nothing selected",
        "choosestring": "Choose...",
        "addstring": "Add"
    }
}}
<div class="mod-booking-sortableselect w-100" id="{{id}}" tabindex="-1" role="group" aria-label="{{plainlabel}}"
    data-region="sortableselect" data-name="{{name}}">
    <input type="hidden" name="{{name}}" value="{{emptyvalue}}">
    <ol class="list-group mb-2 {{^hasitems}}d-none{{/hasitems}}" data-region="sortableselect-list" style="max-width: 32rem;">
        {{#items}}
            {{> mod_booking/form/sortableselect_item }}
        {{/items}}
    </ol>
    <p class="text-muted mb-2 {{#hasitems}}d-none{{/hasitems}}" data-region="sortableselect-empty">
        {{noselectionstring}}
    </p>
    <div class="d-flex align-items-center">
        <label class="sr-only visually-hidden" for="{{id}}_add">{{choosestring}}</label>
        {{! data-fieldtype: the select is inside of the form row of this element, Behat would not treat it as a select. }}
        <select class="custom-select form-select w-auto" id="{{id}}_add" data-region="sortableselect-select" data-fieldtype="select">
            <option value="">{{choosestring}}</option>
            {{#options}}
                <option value="{{value}}" {{#chosen}}disabled hidden{{/chosen}}>{{label}}</option>
            {{/options}}
        </select>
        <button type="button" class="btn btn-secondary ms-2 ml-2" data-action="sortableselect-add">
            {{addstring}}
        </button>
    </div>
    <div class="sr-only visually-hidden" aria-live="polite" data-region="sortableselect-status"></div>
</div>
