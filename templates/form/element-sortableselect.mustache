{{!
    @template mod_booking/form/element-sortableselect

    Form row (label, help, error message) of the form element "sortable select". It extends the row of the
    core form elements, so the element looks like them in every theme and Moodle version.

    Context variables required for this template:
    * label - label of the element
    * required - whether the element is required
    * advanced - whether the element is an advanced element
    * helpbutton - HTML of the help button
    * error - error message
    * element - id, iderror, wrapperid, name, type and html (HTML of the element, see mod_booking/form/sortableselect)

    Example context (json):
    {
        "label": "Priority of the search results",
        "required": false,
        "advanced": false,
        "helpbutton": "",
        "error": null,
        "element": {
            "id": "id_searchprioritycolumns",
            "iderror": "id_error_searchprioritycolumns",
            "wrapperid": "fitem_id_searchprioritycolumns",
            "name": "searchprioritycolumns",
            "type": "sortableselect",
            "html": "<select id=\"id_searchprioritycolumns\"><option value=\"\">Choose...</option></select>"
        }
    }
}}
{{< core_form/element-template }}
    {{$element}}
        {{{element.html}}}
    {{/element}}
{{/ core_form/element-template }}
