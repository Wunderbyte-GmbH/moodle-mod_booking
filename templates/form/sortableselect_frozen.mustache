{{!
    @template mod_booking/form/sortableselect_frozen

    Frozen form element "sortable select": the chosen entries as a list that cannot be changed. With
    "persistent", hidden inputs submit the value, so it is not lost when the form is saved.

    Context variables required for this template:
    * id - id of the element
    * name - name of the element
    * emptyvalue - value that is submitted for an empty list
    * hasitems - whether entries are chosen
    * items - the chosen entries: value, label
    * noselectionstring - text shown while nothing is chosen
    * persistent - whether the value is submitted

    Example context (json):
    {
        "id": "id_searchprioritycolumns",
        "name": "searchprioritycolumns",
        "emptyvalue": "_qf__force_multiselect_submission",
        "hasitems": true,
        "items": [
            {"value": "titleprefix", "label": "Prefix"},
            {"value": "text", "label": "Booking option name"}
        ],
        "noselectionstring": "Nothing selected",
        "persistent": true
    }
}}
<div class="mod-booking-sortableselect w-100" id="{{id}}" data-region="sortableselect-frozen">
    {{#persistent}}<input type="hidden" name="{{name}}" value="{{emptyvalue}}">{{/persistent}}
    {{#hasitems}}
        <ol class="mb-0 ps-3 pl-3">
            {{#items}}
                <li>{{label}}{{#persistent}}<input type="hidden" name="{{name}}[]" value="{{value}}">{{/persistent}}</li>
            {{/items}}
        </ol>
    {{/hasitems}}
    {{^hasitems}}
        <span class="text-muted">{{noselectionstring}}</span>
    {{/hasitems}}
</div>
