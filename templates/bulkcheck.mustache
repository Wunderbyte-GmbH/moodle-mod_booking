{{!
    @template mod_booking/bulkcheck

    The list of rule mails whose sending was parked by the bulk send checker.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-region

    Context variables required for this template:
    * renderedtable - string: the rendered table
    * parked - int: how many mails are parked in this list

    Example context (json):
    {
        "renderedtable": "<div>the rendered table</div>",
        "parked": 3
    }
}}
<div data-region="bulkcheck-list" class="mod_booking_bulkcheck">
    <div class="alert alert-info">{{#str}} bulkcheckparkedintro, mod_booking {{/str}}</div>
    {{{ renderedtable }}}
</div>
