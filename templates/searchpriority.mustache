{{!
    @template mod_booking/searchpriority

    Ordered list of the columns of the instance setting "Priority of the search results".
    Hidden until mod_booking/searchpriority moves it next to the text field "searchprioritycolumns",
    which holds the value (comma separated column names) and is hidden by the module.

    Context variables required for this template:
    * options - array of the columns that can be added: column (name), label

    Example context (json):
    {
        "options": [
            {"column": "titleprefix", "label": "Prefix"},
            {"column": "text", "label": "Booking option name"},
            {"column": "location", "label": "Location"}
        ]
    }
}}
<div class="mod-booking-searchpriority d-none" data-region="searchpriority"
    data-str-moveup="{{#str}} searchprioritycolumns:moveup, mod_booking, LABEL {{/str}}"
    data-str-movedown="{{#str}} searchprioritycolumns:movedown, mod_booking, LABEL {{/str}}"
    data-str-remove="{{#str}} searchprioritycolumns:remove, mod_booking, LABEL {{/str}}">
    <ol class="list-group mb-2" data-region="searchpriority-list" style="max-width: 32rem;"></ol>
    <p class="text-muted mb-2 d-none" data-region="searchpriority-empty">
        {{#str}} searchprioritycolumns:empty, mod_booking {{/str}}
    </p>
    <div class="d-flex align-items-center">
        <label class="sr-only visually-hidden" for="searchpriority-add-{{uniqid}}">
            {{#str}} searchprioritycolumns:choose, mod_booking {{/str}}
        </label>
        {{! data-fieldtype: the list sits in the form row of the text field, Behat would treat the select as a text field. }}
        <select class="custom-select form-select w-auto" id="searchpriority-add-{{uniqid}}"
            data-region="searchpriority-select" data-fieldtype="select">
            <option value="">{{#str}} searchprioritycolumns:choose, mod_booking {{/str}}</option>
            {{#options}}
                <option value="{{column}}">{{label}}</option>
            {{/options}}
        </select>
        <button type="button" class="btn btn-secondary ms-2 ml-2" data-action="searchpriority-add">
            {{#str}} searchprioritycolumns:add, mod_booking {{/str}}
        </button>
    </div>
</div>
