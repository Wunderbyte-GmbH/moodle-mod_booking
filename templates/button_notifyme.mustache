{{!
    @template mod_booking/button_notifyme

    The standalone notify-me widget: wrapper, optional price and the bell.
    This template is only rendered with the data of the button_notifyme
    renderable (fully booked state, where the bell stands alone). It must NOT
    be embedded as a partial into other button templates — partials inherit
    the full parent context and this template would render the parent's price
    a second time. Embedders use mod_booking/button_notifyme_bell instead.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-region

    Example context (json):

    {
        "onlist": true,
        "userid": 1212,
        "itemid": 12,
        "area": "option",
        "price": {
            "price": "10.00",
            "currency": "EUR"
        }
    }
}}
<div class="w-100 d-flex justify-content-center booking-button-area"
    data-itemid="{{itemid}}"
    data-area="{{area}}"

    {{#dataaction}}data-action="{{dataaction}}"{{/dataaction}} >

     {{#price}}
        <div class="pricecontainer mb-2 {{#fullwidth}}w-100{{/fullwidth}}">
            <span class="pricecurrency h5">
                {{price}} {{currency}}
            </span>
                <div>
                    {{> mod_booking/button_notifyme_bell }}
                </div>
        </div>
     {{/price}}
     {{^price}}
        {{> mod_booking/button_notifyme_bell }}
     {{/price}}
</div>
