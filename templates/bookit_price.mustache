{{!
    @template mod_booking/bookit_price

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-region

    Example context (json):
    {
        "itemname" : "myitem",
        "price" : "10",
        "currency" : "EUR",
        "componentname" : "local_shoppingcart",
        "description" : "description",
        "imageurl" : "https://mypic.jpg",
        "pricecategoryidentifier" : "categoryid",
        "pricecategoryname" : "student"
    }
}}
{{#price}}
<div class="w-100 d-flex justify-content-center booking-button-area"
    data-itemid="{{itemid}}"
    data-area="{{area}}"
    data-componentname="mod_booking"
    data-results="{{results}}"
    data-userid="{{userid}}"
    {{#dataaction}}data-action="{{dataaction}}"{{/dataaction}} >
    {{#top}}
        <div class="booking-button-toparea mb-2 {{class}}" role="{{role}}">
            {{{label}}}
        </div>
    {{/top}}
    <div class="pricecontainer mb-2 {{#fullwidth}}w-100{{/fullwidth}}">
        {{!
            The bell sits INSIDE the booking-button-area wrapper on purpose:
            the wrapper is what bookit.js replaces on re-renders, so a bell
            outside of it would survive every update as a stale leftover.
            Only the bare bell partial is embedded - the standalone
            button_notifyme template would inherit this context and render
            the price a second time.
        }}
        {{#onlist}}
            <div class="booking-button-notifyarea mb-3 w-100 text-center">
                {{> mod_booking/button_notifyme_bell }}
            </div>
        {{/onlist}}
        <span class="pricecurrency h5 text-nowrap">
            {{#priceformatted}}{{priceformatted}} {{currency}}{{/priceformatted}}
            {{^priceformatted}}{{price}} {{currency}}{{/priceformatted}}
        </span>
        {{#shoppingcartisavailable}}
            {{#link}}<a href="{{link}}" target="_blank" data-action='bookondetails'>{{/link}}
            <div class="bookit-addtocartbtn-area">
                {{> local_shopping_cart/addtocartdb }}
            </div>
            {{#link}}</a>{{/link}}
        {{/shoppingcartisavailable}}
        {{#priceitems}}
            <p><i>{{pricecategoryname}}</i></p>
        {{/priceitems}}
    </div>
    {{#sub}}
        <div class="booking-button-subarea mb-2 h6 {{class}}" role="{{role}}">
            {{{label}}}
        </div>
    {{/sub}}
</div>
{{/price}}
{{^price}}
    {{#onlist}}
        <div class="booking-button-notifyarea mb-3">
            {{> mod_booking/button_notifyme_bell }}
        </div>
    {{/onlist}}
    {{#priceitems}}
        <div class="pricecurrency mb-2">
            {{#priceformatted}}{{priceformatted}} {{currency}}{{/priceformatted}}
            {{^priceformatted}}{{price}} {{currency}}{{/priceformatted}}
        <i>{{pricecategoryname}}</i>
        </div>
    {{/priceitems}}
{{/price}}
{{^price}}
    {{#str}} nopriceisset, mod_booking, {{pricecategoryidentifier}} {{/str}}
{{/price}}