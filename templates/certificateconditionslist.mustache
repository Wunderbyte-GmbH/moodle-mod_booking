{{!
    @template mod_booking/certificateconditionslist

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-region

    Example context (json):
    {
        "conditions" : [
            {
                "id": 1,
                "name" : "Condition name",
                "contextid": 1,
                "filtername" : "filtername",
                "logicname" : "logicname",
                "actionname" : "actionname",
                "localizedfiltername" : "localizedfiltername",
                "localizedlogicname" : "localizedlogicname",
                "logicdescription" : "2 of 3 selected booking options",
                "iscombination": false,
                "isbuildingblock": true,
                "isunused": false,
                "hasusedin": true,
                "usedin": [{"id": 2, "name": "Combination", "contextid": 1}],
                "groups": [],
                "topoperator": "AND",
                "uniqueoptions": true,
                "hascontextmismatch": false
                "localizedactionname" : "localizedactionname"
            }
        ],
        "contextid": 1
    }
}}

<div class="booking-rules-container">
    {{#enableaddbutton}}
        <div class="btn btn-success booking-rules-addnewrulebtn" data-action="edit-or-new" data-id="0" data-contextid="{{contextid}}" data-certificate="1">
            <i class="fa fa-plus-square" aria-hidden="true"></i>&nbsp;{{#str}} addcertificatecondition, mod_booking {{/str}}
        </div>
    {{/enableaddbutton}}
    {{^enableaddbutton}}
        <div class="alert alert-warning">
            {{#str}} useprotoenablemorecertificateconditions, mod_booking {{/str}}
        </div>
    {{/enableaddbutton}}
    <ul class="mt-3 list-group booking-rules-list">
        {{#conditions}}
        <li class="list-group-item {{#isactive}}ruleactive{{/isactive}} {{^isactive}}ruleinactive{{/isactive}}">
            <div class="d-flex justify-content-between">
                <h5>
                    {{name}}
                    {{#iscombination}}
                        <span class="badge bg-info text-white ml-1">{{#str}} certificateconditionbadgecombination, mod_booking {{/str}}</span>
                    {{/iscombination}}
                    {{#isbuildingblock}}
                        <span class="badge bg-secondary text-white ml-1">{{#str}} certificateconditionbadgebuildingblock, mod_booking {{/str}}</span>
                    {{/isbuildingblock}}
                    {{#isunused}}
                        <span class="badge bg-warning text-dark ml-1">{{#str}} certificateconditionunused, mod_booking {{/str}}</span>
                    {{/isunused}}
                    {{#hascontextmismatch}}
                        <span class="badge bg-warning text-dark ml-1">{{#str}} certificateconditioncontextmismatch, mod_booking {{/str}}</span>
                    {{/hascontextmismatch}}
                </h5>
                <div class="btn-group" role="group" aria-label="Certificate condition buttons">
                    <div class="btn btn-sm btn-outline-danger" data-action="delete" data-id="{{id}}" data-name="{{name}}" data-contextid="{{contextid}}" data-certificate="1">
                        <i class="fa fa-trash" aria-hidden="true"></i> {{#str}} delete {{/str}}
                    </div>
                    <div class="btn btn-sm btn-outline-primary" data-action="edit-or-new" data-id="{{id}}" data-name="{{name}}" data-contextid="{{contextid}}" data-certificate="1">
                        <i class="fa fa-pencil" aria-hidden="true"></i> {{#str}} edit {{/str}}
                    </div>
                </div>
            </div>
            <div class="container">
                <div class="row">
                    <div class="col-sm-1 text-end">
                        <small>
                            {{#isactive}}<i class="fa fa-check" aria-hidden="true"></i> {{/isactive}}
                            {{^isactive}}<i class="fa fa-ban" aria-hidden="true"></i> {{/isactive}}
                        </small>
                    </div>
                    <div class="col-sm-11">
                        <small>
                            {{#isactive}} {{#str}} certificateconditionisactive, mod_booking {{/str}} {{/isactive}}
                            {{^isactive}} {{#str}} certificateconditionisnotactive, mod_booking {{/str}} {{/isactive}}
                        </small>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-1 text-end">
                        <small><i class="fa fa-list-ul" aria-hidden="true"></i></small>
                    </div>
                    <div class="col-sm-11">
                        <small>{{localizedfiltername}}</small>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-1 text-end">
                        <small><i class="fa fa-random" aria-hidden="true"></i></small>
                    </div>
                    <div class="col-sm-11">
                        <small>{{localizedlogicname}}{{#logicdescription}}: {{logicdescription}}{{/logicdescription}}</small>
                    </div>
                </div>
                {{#iscombination}}
                <div class="row">
                    <div class="col-sm-1 text-end">
                        <small><i class="fa fa-cubes" aria-hidden="true"></i></small>
                    </div>
                    <div class="col-sm-11 booking-certcond-groups">
                        <small>{{#str}} certificateconditionbuildingblocks, mod_booking {{/str}}:</small>
                        {{#groups}}
                            <span class="text-nowrap">(
                            {{#leaves}}
                                <span class="badge {{#contextmismatch}}bg-warning text-dark{{/contextmismatch}}{{^contextmismatch}}bg-light text-dark border{{/contextmismatch}}"
                                      role="button" tabindex="0"
                                      {{#contextmismatch}}title="{{#str}} certificateconditioncontextmismatch, mod_booking {{/str}}"{{/contextmismatch}}
                                      data-action="edit-or-new" data-id="{{id}}" data-name="{{name}}" data-contextid="{{contextid}}" data-certificate="1">
                                    <i class="fa fa-pencil" aria-hidden="true"></i> {{name}} ≥ {{requiredcount}}
                                </span>
                                {{^last}}<small class="font-weight-bold">{{operator}}</small>{{/last}}
                            {{/leaves}}
                            )</span>
                            {{^last}}<small class="font-weight-bold mx-1">{{topoperator}}</small>{{/last}}
                        {{/groups}}
                        {{#uniqueoptions}}<small class="text-muted ml-1">[{{#str}} condition_combination_uniqueoptionsshort, mod_booking {{/str}}]</small>{{/uniqueoptions}}
                    </div>
                </div>
                {{/iscombination}}
                {{#hasusedin}}
                <div class="row">
                    <div class="col-sm-1 text-end">
                        <small><i class="fa fa-link" aria-hidden="true"></i></small>
                    </div>
                    <div class="col-sm-11">
                        <small>{{#str}} certificateconditionusedin, mod_booking {{/str}}:</small>
                        {{#usedin}}
                            <span class="badge bg-info text-white" role="button" tabindex="0"
                                  data-action="edit-or-new" data-id="{{id}}" data-name="{{name}}" data-contextid="{{contextid}}" data-certificate="1">
                                <i class="fa fa-pencil" aria-hidden="true"></i> {{name}}
                            </span>
                        {{/usedin}}
                    </div>
                </div>
                {{/hasusedin}}
                <div class="row">
                    <div class="col-sm-1 text-end">
                        <small><i class="fa fa-play" aria-hidden="true"></i></small>
                    </div>
                    <div class="col-sm-11">
                        <small>{{localizedactionname}}</small>
                    </div>
                </div>
            </div>
        </li>
        {{/conditions}}
    </ul>
    {{#displayothercontexts}}
        <div class="mt-4">
            <h5 class="mb-3">{{#str}} certificateconditionsothercontextheading, mod_booking {{/str}}</h5>
            {{#conditionsothercontext}}
                <div>
                    <a href="{{linktoconditionsininstance}}" target="_blank">
                        <i class="fa fa-fw fa-graduation-cap" aria-hidden="true"></i>
                        {{coursename}}
                        <i class="fa fa-fw fa-calendar-check-o" aria-hidden="true"></i>
                        {{bookingname}}
                    </a>
                </div>
            {{/conditionsothercontext}}
            {{^conditionsothercontext}}
                <div>{{#str}} certificateconditionsnootherfound, mod_booking {{/str}}</div>
            {{/conditionsothercontext}}
        </div>
    {{/displayothercontexts}}
</div>